+def _split_name_sizes(name, orig):
+    """('COLLAR S-M', ...) -> ('COLLAR', ['S','M']): las tallas salen del nombre y se guardan aparte; si el nombre fuera solo la talla se conserva."""
+    r = parse_size_spec(name, lone=True)
