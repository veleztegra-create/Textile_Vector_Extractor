+_SZ_KWNUM_RE = re.compile(
+    r"(?<![A-Za-z0-9])(?P<kw>(?:SIZES?|TALLAS?|SZ)\b\s*[:=#]?\s*)"
+    r"(?P<nums>\d{1,3}(?:(?:\s*[,;/]\s*|\s+)\d{1,3})*)"
+    r"(?![A-Za-z0-9])(?!\.\d)(?!\s*[-\u2013\u2014]\s*\d)(?!\s*(?:cm|mm|in|pt)\b)",
