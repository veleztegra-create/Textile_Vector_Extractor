+    if orig and orig != name:
+        r2 = parse_size_spec(orig, lone=True)
+        if r2:
+            sizes |= set(r2["sizes"])
+    if not re.search(r"[A-Za-z0-9]", base or ""):
+        return name, []
+    return base, order_sizes(sizes)
