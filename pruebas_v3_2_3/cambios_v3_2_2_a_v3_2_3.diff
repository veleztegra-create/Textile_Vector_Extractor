+_SIDE_RE = re.compile(r"(?<![A-Za-z0-9])(?:L|R|LT|RT|LFT|RGT|RGHT|LEFT|RIGHT|RIGTH|IZQ|IZQUIERDA|IZQUIERDO|DER|DERECHA|DERECHO)(?![A-Za-z0-9])", re.IGNORECASE)
